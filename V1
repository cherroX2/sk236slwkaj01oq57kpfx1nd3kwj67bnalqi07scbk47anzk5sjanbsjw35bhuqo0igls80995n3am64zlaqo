local TankParts = {
    ["Head"] = true,
    ["Torso"] = true,
    ["HumanoidRootPart"] = true,
    ["Left Arm"] = true,
    ["Right Arm"] = true,
    ["Left Leg"] = true,
    ["Right Leg"] = true,
}

local TankBillboard, TankHighlight
local PartHighlights = {}

local function ApplyTankState()
    local char = LocalPlayer.Character
    if not char then return end

    if not TankHighlight then
        TankHighlight = Instance.new("Highlight")
        TankHighlight.Name = "TankClientHighlight"
        TankHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        TankHighlight.FillTransparency = 0.85
        TankHighlight.OutlineTransparency = 0.25
        TankHighlight.Parent = char
    end
    TankHighlight.Enabled = TankEnabled

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and not TankBillboard then
        TankBillboard = Instance.new("BillboardGui")
        TankBillboard.Name = "TankClientBillboard"
        TankBillboard.Size = UDim2.fromOffset(140, 30)
        TankBillboard.StudsOffset = Vector3.new(0, 3, 0)
        TankBillboard.AlwaysOnTop = true
        TankBillboard.Parent = hrp

        local txt = Instance.new("TextLabel")
        txt.Name = "Label"
        txt.BackgroundTransparency = 1
        txt.Size = UDim2.fromScale(1, 1)
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 14
        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        txt.Parent = TankBillboard
    end

    if TankBillboard and TankBillboard:FindFirstChild("Label") then
        TankBillboard.Enabled = TankEnabled
        TankBillboard.Label.Text = TankEnabled and "TANK: ON" or "TANK: OFF"
    end

    for _, inst in ipairs(char:GetChildren()) do
        if inst:IsA("BasePart") then
            local wanted = TankEnabled and TankParts[inst.Name] == true
            if wanted and not PartHighlights[inst] then
                local h = Instance.new("Highlight")
                h.Name = "TankPartClientHighlight"
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 1
                h.OutlineTransparency = 0
                h.Parent = inst
                PartHighlights[inst] = h
            elseif (not wanted) and PartHighlights[inst] then
                PartHighlights[inst]:Destroy()
                PartHighlights[inst] = nil
            end
        end
    end
end

local function ClearTouchInterests()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("TouchTransmitter") then
            v:Destroy()
        end
    end
end

local function UpdateTouchState()
    if IgnoreTouchEnabled then
        ClearTouchInterests()
        if not TouchListener then
            TouchListener = workspace.DescendantAdded:Connect(function(desc)
                if IgnoreTouchEnabled and desc:IsA("TouchTransmitter") then
                    task.wait()
                    desc:Destroy()
                end
            end)
        end
    else
        if TouchListener then
            TouchListener:Disconnect()
            TouchListener = nil
        end
    end
end

