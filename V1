local playerButtons = {}

local function rebuildPlayers()
    for _, c in ipairs(PlayersList:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    table.clear(playerButtons)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end 
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 42)
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 14
        btn.Text = plr.DisplayName
        btn.Parent = PlayersList
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

        btn.MouseButton1Click:Connect(function()
            for _, b in pairs(playerButtons) do
                b.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
            end
            btn.BackgroundColor3 = Color3.fromRGB(42, 42, 52)
            updateSelected(plr)
        end)

        playerButtons[plr.UserId] = btn
    end

    task.defer(function()
        PlayersList.CanvasSize = UDim2.new(0, 0, 0, PlayersListLayout.AbsoluteContentSize.Y + 12)
    end)
end

