if RunService and RunService.RenderStepped then
    local FlingFixLoop = RunService.RenderStepped:Connect(function()
        if HitboxExpander.Enabled or HitboxVisualizer.Enabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == LocalPlayer or Whitelist[plr.UserId] or not plr.Character then continue end

                local hum = getHumanoid(plr)
                if hum and hum.Health <= Settings.EnemyHealthStop then continue end 

                    for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.CollisionGroup = NoCollideGroup 
                        
                        if HitboxExpander.Enabled and part.Name == "HumanoidRootPart" then
                            part.Shape = Enum.PartType.Block
                        end
                    end
                end
            end
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == LocalPlayer or not plr.Character then continue end
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        -- Only revert if it was modified
                        if part.CanCollide == false and part.Name ~= "HumanoidRootPart" then 
                            part.CanCollide = true
                        end
                        if part.CollisionGroup == NoCollideGroup then
                            part.CollisionGroup = DefaultGroup
                        end
                        
                        if part.Name == "HumanoidRootPart" and HitboxExpander.OriginalPartType[plr.UserId] then
                            part.Shape = HitboxExpander.OriginalPartType[plr.UserId]
                        end
                    end
                end
            end
        end
    end)
else
    warn("Failed to connect to RunService.RenderStepped. Hitbox expansion stability may be compromised.")
end

