local function getHumanoid(plr)
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function GetTarget()
    local closest, shortest = nil, math.huge
    local m = UIS:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    local mx, my = m.X, m.Y - inset.Y

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            
            if Whitelist[p.UserId] then continue end
            
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > Settings.EnemyHealthStop then
                local pos, vis = Camera:WorldToViewportPoint(hrp.Position)
                if vis then
                    local d = (Vector2.new(pos.X,pos.Y) - Vector2.new(mx,my)).Magnitude
                    if d < shortest then shortest, closest = d, p end
                end
            end
        end
    end
    return closest
end

local function StartAimbot()
    if Cycle then Cycle:Disconnect() end
    Target = nil
    
    if RunService and RunService.RenderStepped then
        Cycle = RunService.RenderStepped:Connect(function()
            if not StickyLock or not Target then Target = GetTarget() end
            if not Target or not Target.Character then 
                Target = nil
                return
            end
            
            local hum = Target.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= Settings.EnemyHealthStop then
                if Cycle then Cycle:Disconnect() end
                Target = nil
                IsToggled = false
                AimbotHeld = false
                return
            end
            
            if Whitelist[Target.UserId] then 
                Target = nil 
                return 
            end

            local hrp = Target.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local vel = hrp.Velocity
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            local mult = math.clamp(dist / getgenv().Aimbot.Distance.Reference, 1, getgenv().Aimbot.Distance.MaxMultiplier)

            local pred = hrp.Position + Vector3.new(
                vel.X * getgenv().Aimbot.Prediction.X * mult,
                vel.Y * getgenv().Aimbot.Prediction.Y,
                vel.Z * getgenv().Aimbot.Prediction.X * mult
            )

            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pred)
        end)
    else
        warn("RunService not available for Aimbot cycle.")
    end
end

local function MatchesBind(input)
    local b = getgenv().Aimbot.Bind
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name == b
    end
    return (b == "MouseButton4" and input.UserInputType == Enum.UserInputType.MouseButton4)
        or (b == "MouseButton5" and input.UserInputType == Enum.UserInputType.MouseButton5)
end

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end 

    if MatchesBind(input) then
        if AimbotMode == "Toggle" then
            if not IsToggled then 
                StartAimbot() 
            else 
                if Cycle then Cycle:Disconnect() end 
                Target = nil 
            end
            IsToggled = not IsToggled
        elseif AimbotMode == "Hold" and not AimbotHeld then
            StartAimbot()
            AimbotHeld = true
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if AimbotMode == "Hold" and MatchesBind(input) then
        if Cycle then Cycle:Disconnect() end
        Target = nil
        AimbotHeld = false
    end
end)

local function ApplyHitboxState(plr)
    local char = plr.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local isWhitelisted = Whitelist[plr.UserId]
    local isLocalPlayer = plr == LocalPlayer
    
    local isDying = hum.Health <= Settings.EnemyHealthStop

    if isLocalPlayer then 
        return 
    end
    
    local isAnyActive = HitboxExpander.Enabled or HitboxVisualizer.Enabled
    local applyActiveState = isAnyActive and not isWhitelisted and not isDying
    local forceRestore = isDying or isWhitelisted or (not HitboxExpander.Enabled and not HitboxVisualizer.Enabled)
    
    if HitboxExpander.Enabled and applyActiveState then
        if not HitboxExpander.OriginalSizes[plr.UserId] then
            HitboxExpander.OriginalSizes[plr.UserId] = hrp.Size
            HitboxExpander.OriginalPartType[plr.UserId] = hrp.Shape 
        end
        hrp.Size = HitboxExpander.OriginalSizes[plr.UserId] * HitboxExpander.Scale
    elseif forceRestore then
        if HitboxExpander.OriginalSizes[plr.UserId] then
            hrp.Size = HitboxExpander.OriginalSizes[plr.UserId]
            HitboxExpander.OriginalSizes[plr.UserId] = nil
        end
        if HitboxExpander.OriginalPartType[plr.UserId] then
            hrp.Shape = HitboxExpander.OriginalPartType[plr.UserId]
            HitboxExpander.OriginalPartType[plr.UserId] = nil
        end
    end


    if HitboxVisualizer.Enabled and applyActiveState then
        if not HitboxExpander.OriginalTransparency[plr.UserId] then
            HitboxExpander.OriginalTransparency[plr.UserId] = hrp.Transparency
        end
        hrp.Transparency = 0.5
        hrp.Color = isWhitelisted and Settings.Colors.Ally or Settings.Colors.Enemy
    elseif forceRestore and HitboxExpander.OriginalTransparency[plr.UserId] then
        hrp.Transparency = HitboxExpander.OriginalTransparency[plr.UserId]
        hrp.Color = Color3.new(0, 0, 0)
        HitboxExpander.OriginalTransparency[plr.UserId] = nil
    end
    
    local targetGroup = applyActiveState and NoCollideGroup or DefaultGroup
    hrp.CollisionGroup = targetGroup
    
    if applyActiveState then
        if not HitboxExpander.OriginalJoints[plr.UserId] then
            HitboxExpander.OriginalJoints[plr.UserId] = {}
            for _, joint in ipairs(char:GetDescendants()) do
                if joint:IsA("Motor6D") or joint:IsA("JointInstance") then
                    -- Disable the joint to prevent flinging
                    joint.Enabled = false 
                    table.insert(HitboxExpander.OriginalJoints[plr.UserId], joint)
                end
            end
        end
    elseif forceRestore and HitboxExpander.OriginalJoints[plr.UserId] then
        for _, joint in ipairs(HitboxExpander.OriginalJoints[plr.UserId]) do
            if joint and (joint:IsA("Motor6D") or joint:IsA("JointInstance")) then
                joint.Enabled = true
            end
        end
        HitboxExpander.OriginalJoints[plr.UserId] = nil
    end

end


local function setupPlayerHitbox(plr)
    if plr == LocalPlayer then return end
    
    plr.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.1) 
        ApplyHitboxState(plr)
        
        local hum = getHumanoid(plr)
        if hum then
            hum.HealthChanged:Connect(function(newHealth)
                ApplyHitboxState(plr)
                
                if newHealth <= Settings.EnemyHealthStop and Target == plr then
                    if Cycle then Cycle:Disconnect() end
                    Target = nil
                    IsToggled = false
                    AimbotHeld = false
                end
            end)
        end
    end)
    
    if plr.Character then
        ApplyHitboxState(plr)
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
    setupPlayerHitbox(plr)
end

