-- Helper: Validation Logic
local function IsValid(plr)
    if plr and plr.Character and plr.Character:FindFirstChild(AimPart) and plr.Character:FindFirstChild("Humanoid") then
        local isAlive = plr.Character.Humanoid.Health > 0
        local isNotWhitelisted = not getgenv().WhitelistedPlayers[plr.Name]
        return isAlive and isNotWhitelisted
    end
    return false
end

-- Helper: Local Integrity
local function IsLocalAlive()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health > 0
end

-- Main RenderLoop: FOV and Aim Assist
RunService.RenderStepped:Connect(function()
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local originPos = (AimMethod == "Mouse") and UserInputService:GetMouseLocation() or Center
    
    -- FOV Rendering
    if ShowFOV and AimAssistEnabled and IsLocalAlive() then
        FOVCircle.Position = originPos
        FOVCircle.Radius = FOVRadius
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- Aim Assist Execution
    if AimAssistEnabled and IsLocalAlive() then
        local target = nil

        -- Sticky Logic Priority
        if StickyAim and LockedTarget and IsValid(LockedTarget) then
            local pos, onScreen = Camera:WorldToViewportPoint(LockedTarget.Character[AimPart].Position)
            local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
            if onScreen and dist <= FOVRadius then
                target = LockedTarget
            end
        end

        -- Search for nearest target in FOV
        if not target then
            local lastDist = FOVRadius
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and IsValid(player) then
                    local pos, onScreen = Camera:WorldToViewportPoint(player.Character[AimPart].Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
                        if dist < lastDist then
                            lastDist = dist
                            target = player
                            if StickyAim then LockedTarget = player end
                        end
                    end
                end
            end
        end

        -- Execute Aim
        if target then
            local targetPart = target.Character[AimPart]
            local finalTargetPos = targetPart.Position
            
            if PredictionEnabled then
                local vel = targetPart.Velocity
                finalTargetPos = finalTargetPos + Vector3.new(vel.X * PredictionX, vel.Y * PredictionY, vel.Z * PredictionX)
            end

            if AimMethod == "Camera" then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, finalTargetPos), AimSmoothness)
            elseif AimMethod == "Mouse" then
                local screenPos = Camera:WorldToViewportPoint(finalTargetPos)
                local mPos = UserInputService:GetMouseLocation()
                mousemoverel((screenPos.X - mPos.X) * AimSmoothness, (screenPos.Y - mPos.Y) * AimSmoothness)
            end
        end
    else
        LockedTarget = nil
    end
end)

-- [[ 6. HITBOX MECHANIC & DEFENSE ]]

local function applyHitbox(character)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    hrp.Size = Vector3.new(ReachSize, ReachSize, ReachSize)
    hrp.Transparency = Trans
    hrp.Color = Color3.fromRGB(255, 0, 0)
    hrp.Material = Enum.Material.Neon
    hrp.CanCollide = false 

    local connection = hrp:GetPropertyChangedSignal("CanCollide"):Connect(function()
        if ReachEnabled then
            hrp.CanCollide = false
        end
    end)
end

-- Heartbeat Loop: Collision, Hitboxes, and Defenses
RunService.Heartbeat:Connect(function()
    -- Hitbox Expansion Loop (From User Snippet)
    if ReachEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not getgenv().WhitelistedPlayers[player.Name] then
                        hrp.CanCollide = false
                        if hrp.Size.X ~= ReachSize or hrp.Transparency ~= Trans then
                            hrp.Size = Vector3.new(ReachSize, ReachSize, ReachSize)
                            hrp.Transparency = Trans
                            hrp.Color = Color3.fromRGB(255, 0, 0)
                            hrp.Material = Enum.Material.Neon
                        end
                    else
                        -- Reset Whitelist Size
                        if hrp.Size.X == ReachSize then
                            hrp.Size = Vector3.new(2, 2, 1)
                            hrp.Transparency = 1
                        end
                    end
                end
            end
        end
    end

    -- Defense Logic (Ultra Tank & Desync)
    if IsLocalAlive() then
        if TankActive then
            LocalPlayer.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            LocalPlayer.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
        if DesyncActive then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local oldV = root.Velocity
                root.Velocity = Vector3.new(0, -200, 0)
                RunService.RenderStepped:Wait()
                root.Velocity = oldV
            end
        end
    end
end)

-- Initial Character Handling
local function setupPlayer(player)
    player.CharacterAdded:Connect(function(character)
        if ReachEnabled then
            task.wait(0.1)
            applyHitbox(character)
        end
    end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        setupPlayer(player)
    end
end

