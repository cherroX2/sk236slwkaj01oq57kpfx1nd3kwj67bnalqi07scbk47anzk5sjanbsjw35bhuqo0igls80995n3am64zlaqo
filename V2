local function GetNames()
    local n = {}
    for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(n, p.Name) end end
    return n
end

local PlayerDropdown = PlayerTab:CreateDropdown({
    Name = "Select Player",
    Options = GetNames(),
    Callback = function(v)
        local val = (type(v) == "table") and v[1] or v
        local target = Players:FindFirstChild(val)
        if target then
            getgenv().SelectedTarget = target.Name
            NameLabel:Set("Selected: " .. target.DisplayName)
            StatusLabel:Set("Whitelisted: " .. (getgenv().WhitelistedPlayers[target.Name] and "YES" or "NO"))
        end
    end
})

