-- Aim Assist Core
local function IsValid(plr)
    if plr and plr.Character and plr.Character:FindFirstChild(AimPart) and plr.Character:FindFirstChild("Humanoid") then
        local healthValid = plr.Character.Humanoid.Health > 0
        local whiteValid = not getgenv().WhitelistedPlayers[plr.Name]
        return healthValid and whiteValid
    end
    return false
end

local function IsLocalAlive()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health > 0
end

RunService.RenderStepped:Connect(function()
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local originPos = (AimMethod == "Mouse") and UserInputService:GetMouseLocation() or Center
    
    -- FOV Update
    if ShowFOV and AimAssistEnabled and IsLocalAlive() then
        FOVCircle.Position = originPos
        FOVCircle.Radius = FOVRadius
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- Aim Assist Logic
    if AimAssistEnabled and IsLocalAlive() then
        local target = nil

        -- Sticky Logic
        if StickyAim and LockedTarget and IsValid(LockedTarget) then
            local pos, onScreen = Camera:WorldToViewportPoint(LockedTarget.Character[AimPart].Position)
            local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
            if onScreen and dist <= FOVRadius then target = LockedTarget end
        end

        -- Target Search
        if not target then
            local lastDist = FOVRadius
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and IsValid(player) then
                    local pos, onScreen = Camera:WorldToViewportPoint(player.Character[AimPart].Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - originPos).Magnitude
                        if dist < lastDist then
                            lastDist = dist
                            target = player
                            if StickyAim then LockedTarget = player end
                        end
                    end
                end
            end
        end

        -- Aim Execution
        if target then
            local targetPart = target.Character[AimPart]
            local finalTargetPos = targetPart.Position
            if PredictionEnabled then
                local vel = targetPart.Velocity
                finalTargetPos = finalTargetPos + Vector3.new(vel.X * PredictionX, vel.Y * PredictionY, vel.Z * PredictionX)
            end
            if AimMethod == "Camera" then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, finalTargetPos), AimSmoothness)
            else
                local screenPos = Camera:WorldToViewportPoint(finalTargetPos)
                local mPos = UserInputService:GetMouseLocation()
                mousemoverel((screenPos.X - mPos.X) * AimSmoothness, (screenPos.Y - mPos.Y) * AimSmoothness)
            end
        end
    else
        LockedTarget = nil
    end

    -- Reach & Collision Loop
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            -- Collision Fling Logic
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                if ReachEnabled and not getgenv().WhitelistedPlayers[player.Name] then
                    root.Size = Vector3.new(ReachSize, ReachSize, ReachSize)
                    root.Transparency = Trans
                    root.Color = Color3.fromRGB(255, 0, 0)
                else
                    root.Size = Vector3.new(2, 2, 1)
                    root.Transparency = 1
                end
            end
        end
    end
end)

